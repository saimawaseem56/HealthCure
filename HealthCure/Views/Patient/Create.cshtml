@model HealthCure.Models.Patient

@{
    ViewData["Title"] = "Add Patient";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>
                <i class="bi bi-person-plus"></i>
                Add Patient
            </h3>
        </div>


        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control" />

                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Gender
                    </label>

                    <select asp-for="Gender"
                            class="form-control">

                        <option value="">
                            Select Gender
                        </option>

                        <option value="Male">
                            Male
                        </option>

                        <option value="Female">
                            Female
                        </option>

                    </select>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Date Of Birth
                    </label>

                    <input asp-for="DateOfBirth"
                           type="date"
                           class="form-control" />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           class="form-control" />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Address
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"></textarea>

                </div>


                <button type="submit"
                        class="btn btn-primary">
                    Save Patient
                </button>


                <a href="/Patient/Index"
                   class="btn btn-secondary">
                    Back
                </a>


            </form>

        </div>

    </div>

</div>