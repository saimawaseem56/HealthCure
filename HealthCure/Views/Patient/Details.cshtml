@model HealthCure.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container mt-4">

    <h2 class="text-primary">
        Patient Details
    </h2>

    <table class="table table-bordered">

        <tr>
            <th>Patient ID</th>
            <td>@Model.PatientId</td>
        </tr>

        <tr>
            <th>Name</th>
            <td>@Model.FullName</td>
        </tr>

        <tr>
            <th>Gender</th>
            <td>@Model.Gender</td>
        </tr>

        <tr>
            <th>Date Of Birth</th>
            <td>@Model.DateOfBirth</td>
        </tr>

        <tr>
            <th>Phone</th>
            <td>@Model.Phone</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>

        <tr>
            <th>Address</th>
            <td>@Model.Address</td>
        </tr>

    </table>

    <a href="/Patient/Index" class="btn btn-secondary">
        Back
    </a>

</div>