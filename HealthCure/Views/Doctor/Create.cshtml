@model HealthCure.Models.Doctor

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Add Doctor - HealthCure</title>

    <link href="~/Admin/vendor/bootstrap/css/bootstrap.min.css"
          rel="stylesheet" />

</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                <h4>Add New Doctor</h4>
            </div>

            <div class="card-body">

                <form asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label>Doctor Name</label>
                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter Doctor Name" />
                    </div>
                    <div class="mb-3">

                        <label class="form-label">
                            Doctor Image
                        </label>

                        <input type="file"
                               name="imageFile"
                               class="form-control" />

                        <span asp-validation-for="ImageUrl"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-3">
                        <label>Specialization</label>
                        <input asp-for="Specialization"
                               class="form-control"
                               placeholder="Cardiologist, Surgeon etc." />
                    </div>

                    <div class="mb-3">
                        <label>Qualification</label>
                        <input asp-for="Qualification"
                               class="form-control"
                               placeholder="MBBS, FCPS" />
                    </div>

                    <div class="mb-3">
                        <label>Experience (Years)</label>
                        <input asp-for="Experience"
                               type="number"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Phone</label>
                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="03001234567" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Department</label>

                        <select asp-for="DepartmentId"
                                asp-items="ViewBag.DepartmentId"
                                class="form-select">

                            <option value="">Select Department</option>

                        </select>
                    </div>


                    <div class="mb-3">
                        <label>Description</label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Doctor description">
                    </textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Doctor
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                </form>

            </div>

        </div>

    </div>

</body>
</html>
